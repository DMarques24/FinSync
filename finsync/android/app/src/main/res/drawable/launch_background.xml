<?xml version="1.0" encoding="utf-8"?>
<!-- Ecrã de arranque. O fundo acompanha o tema claro/escuro; o logo fica
     ao centro, no mesmo sítio onde o StartupPage o vai desenhar a seguir,
     para não haver salto visível entre o arranque nativo e o Flutter. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
